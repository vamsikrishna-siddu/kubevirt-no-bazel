ARG BUILDER_IMAGE=quay.io/kubevirt/builder:2606231619-4fe2cd536f
ARG TESTING_BASE_IMAGE=quay.io/kubevirt/kubevirt-testing-base:latest

FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder

ARG BUILD_ARCH=amd64

WORKDIR /workspace

# The builder runs on the build host, so both binaries need the target GOARCH
RUN case ${BUILD_ARCH} in \
        arm64|aarch64|crossbuild-aarch64) echo arm64 ;; \
        s390x|crossbuild-s390x) echo s390x ;; \
        *) echo amd64 ;; \
    esac > /tmp/goarch

RUN source /etc/profile.d/gimme.sh && \
    git clone https://github.com/masterzen/winrm-cli.git && \
    cd winrm-cli && \
    GOOS=linux GOARCH=$(cat /tmp/goarch) go build -o /tmp/winrm-cli

# Build winrmcp (no go.mod in upstream repo)
RUN source /etc/profile.d/gimme.sh && \
    git clone https://github.com/packer-community/winrmcp.git && \
    cd winrmcp && \
    git checkout c76d91c1e7db27b0868c5d09e292bb540616c9a2 && \
    go mod init github.com/packer-community/winrmcp && \
    go mod tidy && \
    GOOS=linux GOARCH=$(cat /tmp/goarch) go build -o /tmp/winrmcp

FROM ${TESTING_BASE_IMAGE}

COPY --from=builder --chmod=0755 /tmp/winrm-cli /usr/bin/winrm-cli
COPY --from=builder --chmod=0755 /tmp/winrmcp /usr/bin/winrmcp
