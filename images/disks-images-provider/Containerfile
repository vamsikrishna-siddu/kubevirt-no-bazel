# hack/build-images-container.sh sets the image build arguments.
ARG BUILDER_IMAGE
ARG TESTING_BASE_IMAGE

FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS disk-builder

WORKDIR /workspace

RUN mkdir -p /workspace/images/custom && \
    truncate -s 64M /workspace/images/custom/disk.img

FROM ${TESTING_BASE_IMAGE}
ARG ALPINE_ISO

COPY --from=disk-builder /workspace/images /images
# The Alpine ISO of WORKSPACE, from the alpine-iso build context
COPY --from=alpine-iso ${ALPINE_ISO} /images/alpine/disk.img

COPY images/disks-images-provider/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
