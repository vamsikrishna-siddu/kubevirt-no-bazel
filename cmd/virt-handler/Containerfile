# hack/build-image-binaries.sh compiles the programs into _out/cmd/, and
# hack/build-images-container.sh sets the image build arguments.
ARG HANDLERBASE_IMAGE

FROM ${HANDLERBASE_IMAGE}

COPY cmd/virt-handler/nsswitch.conf /etc/nsswitch.conf

COPY _out/cmd/virt-handler/virt-handler /usr/bin/virt-handler
COPY _out/cmd/virt-chroot/virt-chroot /usr/bin/virt-chroot

COPY .version /.version

ENTRYPOINT ["/usr/bin/virt-handler"]
