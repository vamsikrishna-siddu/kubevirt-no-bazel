# hack/build-image-binaries.sh compiles the programs into _out/cmd/, and
# hack/build-images-container.sh sets the image build arguments.
ARG EXPORTSERVERBASE_IMAGE

FROM ${EXPORTSERVERBASE_IMAGE}

COPY _out/cmd/virt-exportserver/virt-exportserver /usr/bin/virt-exportserver

COPY .version /.version

USER 1001

ENTRYPOINT ["/usr/bin/virt-exportserver"]
