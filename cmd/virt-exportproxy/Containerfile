# hack/build-image-binaries.sh compiles the programs into _out/cmd/, and
# hack/build-images-container.sh sets the image build arguments.
ARG DISTROLESS_BASE_IMAGE

FROM ${DISTROLESS_BASE_IMAGE}

COPY _out/cmd/virt-exportproxy/virt-exportproxy /usr/bin/virt-exportproxy

COPY .version /.version

COPY --chmod=0644 .passwd /etc/passwd

USER 1001

ENTRYPOINT ["/usr/bin/virt-exportproxy"]
