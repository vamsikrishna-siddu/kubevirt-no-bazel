# hack/build-images-container.sh sets the image build arguments.
ARG PR_HELPER_BASE_IMAGE

FROM ${PR_HELPER_BASE_IMAGE}

COPY cmd/pr-helper/multipath.conf /etc/multipath.conf
COPY --chmod=0755 cmd/pr-helper/entrypoint.sh /entrypoint.sh

COPY .version /.version

USER 1001

ENTRYPOINT ["/entrypoint.sh"]
