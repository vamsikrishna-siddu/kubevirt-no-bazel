# hack/build-images-container.sh sets the image build arguments.
ARG BUILDER_IMAGE
ARG SIDECAR_SHIM_IMAGE

FROM ${BUILDER_IMAGE} AS builder

ARG BUILD_ARCH=amd64
ARG KUBEVIRT_VERSION

WORKDIR /workspace

COPY . .

RUN source /etc/profile.d/gimme.sh && \
    CGO_ENABLED=0 BIN_NAME=disk-mutation hack/build-go.sh install cmd/sidecars/disk-mutation

RUN cp /workspace/_out/cmd/disk-mutation/disk-mutation /tmp/onDefineDomain

FROM ${SIDECAR_SHIM_IMAGE}

ARG BUILD_ARCH=amd64
ARG KUBEVIRT_VERSION

COPY --from=builder /tmp/onDefineDomain /usr/bin/onDefineDomain

COPY --from=builder /workspace/.version /.version
