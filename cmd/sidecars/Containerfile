# hack/build-images-container.sh sets the image build arguments.
ARG BUILDER_IMAGE
ARG SIDECAR_SHIM_BASE_IMAGE

FROM ${BUILDER_IMAGE} AS builder

ARG BUILD_ARCH=amd64
ARG KUBEVIRT_VERSION

WORKDIR /workspace

COPY . .

RUN source /etc/profile.d/gimme.sh && \
    CGO_ENABLED=0 BIN_NAME=sidecars hack/build-go.sh install cmd/sidecars

FROM ${SIDECAR_SHIM_BASE_IMAGE}

COPY --from=builder /workspace/_out/cmd/sidecars/sidecars /usr/bin/sidecar-shim

COPY --from=builder /workspace/.version /.version

USER 1001

ENTRYPOINT ["/usr/bin/sidecar-shim"]
