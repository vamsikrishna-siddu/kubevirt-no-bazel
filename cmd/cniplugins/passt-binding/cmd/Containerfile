# hack/build-images-container.sh sets the image build arguments.
ARG BUILDER_IMAGE
ARG BUSYBOX_IMAGE

FROM --platform=$BUILDPLATFORM ${BUILDER_IMAGE} AS builder

ARG BUILD_ARCH=amd64
ARG KUBEVIRT_VERSION

WORKDIR /workspace

COPY . .

# Static, as in the Bazel build: the binary runs on the host, not in this image
RUN source /etc/profile.d/gimme.sh && \
    CGO_ENABLED=0 hack/build-go.sh install cmd/cniplugins/passt-binding/cmd

FROM ${BUSYBOX_IMAGE}

ARG BUILD_ARCH=amd64
ARG KUBEVIRT_VERSION

COPY --from=builder /workspace/_out/cmd/cmd/cmd /cni/kubevirt-passt-binding

ENTRYPOINT ["/cni/kubevirt-passt-binding"]
